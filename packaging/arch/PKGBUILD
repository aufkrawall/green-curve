# Maintainer: aufkrawall <https://github.com/aufkrawall/green-curve>

pkgname=greencurve
pkgver=0.27.0
pkgrel=1
pkgdesc="NVIDIA VF curve, overclock, undervolt and fan control daemon & terminal UI"
arch=('x86_64' 'aarch64')
url="https://github.com/aufkrawall/green-curve"
license=('MIT')
depends=('glibc')
optdepends=('nvidia-utils: proprietary NVIDIA driver libraries (libnvidia-api.so.1, libnvidia-ml.so.1)')
makedepends=('python' 'zig')
install=greencurve.install
source=(
    "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
    "greencurve.service"
    "greencurve-resume.service"
    "greencurve.sysusers"
    "greencurve.desktop"
    "greencurve.png"
)
sha256sums=(
    'b508dfc57397f1494086c958cc1c93bf4e054c72b825cfd276979555d7c3b99a'
    'ab54902d53821b375a471990d515eb38a006971cc2b66352dba9a2d69793726e'
    '2aa2e91a0ae63c2dac16689ed8b824a2f774fb550cb5d56d3385516fd6e71528'
    'ea609d86699918483679359aff45bcd5d1344a76fee3b4dac6cf6805b6b272c7'
    '70df9616dbba8cd76600dca962432813f2a4562175a8f322cc0c103a760b82e0'
    'b834cc7fc3a5614a65b55f2d1c49c73927bf7d512b7ebb4fb9a02c1408ef19d1'
)

# The source archive is pinned to the reviewed release tree. Update its digest
# with pkgver; a placeholder must never silently disable verification.
_gc_placeholder=0
for _gc_sum in "${sha256sums[@]}"; do
    [ "$_gc_sum" = "SKIP" ] && _gc_placeholder=1
done
if [ "$_gc_placeholder" = "1" ]; then
    echo "error: the source tarball digest is not pinned." >&2
    echo "  Fetch $url/archive/refs/tags/$pkgver.tar.gz over a channel you trust," >&2
    echo "  run: sha256sum greencurve-$pkgver.tar.gz" >&2
    echo "  and replace the SKIP above with that digest." >&2
    return 1 2>/dev/null || exit 1
fi

build() {
    cd "$pkgname-$pkgver"

    local _gc_arch
    case "$CARCH" in
        x86_64)  _gc_arch="x64" ;;
        aarch64) _gc_arch="arm64" ;;
        *)       echo "Unsupported architecture: $CARCH" >&2; exit 1 ;;
    esac

    # If system zig is installed and present in PATH, point build.py to it
    if command -v zig >/dev/null 2>&1; then
        export ZIG_EXE="$(command -v zig)"
    fi

    python build.py --target linux --arch "$_gc_arch" --no-package
}

package() {
    cd "$pkgname-$pkgver"

    local _gc_arch
    case "$CARCH" in
        x86_64)  _gc_arch="x64" ;;
        aarch64) _gc_arch="arm64" ;;
    esac

    # Binary
    install -Dm755 "dist/linux-${_gc_arch}/greencurve/greencurve" "$pkgdir/usr/bin/greencurve"

    # Systemd service units
    install -Dm644 "$srcdir/greencurve.service" "$pkgdir/usr/lib/systemd/system/greencurve.service"
    install -Dm644 "$srcdir/greencurve-resume.service" "$pkgdir/usr/lib/systemd/system/greencurve-resume.service"

    # Declarative group creation via sysusers
    install -Dm644 "$srcdir/greencurve.sysusers" "$pkgdir/usr/lib/sysusers.d/greencurve.conf"

    # Desktop launcher
    install -Dm644 "$srcdir/greencurve.desktop" "$pkgdir/usr/share/applications/greencurve.desktop"

    # Application icons
    install -Dm644 "$srcdir/greencurve.png" "$pkgdir/usr/share/pixmaps/greencurve.png"
    python tools/icon_render.py --export-hicolor "$pkgdir/usr/share" 2>/dev/null || \
        install -Dm644 "$srcdir/greencurve.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/greencurve.png"

    # License and documentation
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
