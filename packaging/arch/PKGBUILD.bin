# Maintainer: aufkrawall <https://github.com/aufkrawall/green-curve>

pkgname=greencurve-bin
pkgver=0.24.0
pkgrel=1
pkgdesc="NVIDIA VF curve, overclock, undervolt and fan control daemon & terminal UI (precompiled binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/aufkrawall/green-curve"
license=('MIT')
depends=('glibc')
optdepends=('nvidia-utils: proprietary NVIDIA driver libraries (libnvidia-api.so.1, libnvidia-ml.so.1)')
provides=('greencurve')
conflicts=('greencurve')
install=greencurve.install
source=(
    "greencurve.service"
    "greencurve-resume.service"
    "greencurve.sysusers"
    "greencurve.desktop"
    "greencurve.png"
)
source_x86_64=("$url/releases/download/$pkgver/greencurve-$pkgver-linux-x64.tar.xz")
source_aarch64=("$url/releases/download/$pkgver/greencurve-$pkgver-linux-arm64.tar.xz")
sha256sums=(
    'ab54902d53821b375a471990d515eb38a006971cc2b66352dba9a2d69793726e'
    'b5a58d0cdf6fd713765b69f470f670c4d8e3283e6862a5a37b92209ce2c3104c'
    'ea609d86699918483679359aff45bcd5d1344a76fee3b4dac6cf6805b6b272c7'
    '70df9616dbba8cd76600dca962432813f2a4562175a8f322cc0c103a760b82e0'
    'b834cc7fc3a5614a65b55f2d1c49c73927bf7d512b7ebb4fb9a02c1408ef19d1'
)
sha256sums_x86_64=('a3224f88b81c7d1a9b3cf47ccc7f76de78459e276c145e12b12643402cb484a1')
sha256sums_aarch64=('4f22b24287b99b62da8eb2b6ad5d0ae4c9ec62fafda0a5e8d719097462b5bf82')

package() {
    local _gc_arch
    case "$CARCH" in
        x86_64)  _gc_arch="x64" ;;
        aarch64) _gc_arch="arm64" ;;
    esac

    local _src="greencurve-$pkgver-linux-${_gc_arch}"

    # Binary
    install -Dm755 "$srcdir/$_src/greencurve" "$pkgdir/usr/bin/greencurve"

    # Systemd service units
    install -Dm644 "$srcdir/greencurve.service" "$pkgdir/usr/lib/systemd/system/greencurve.service"
    install -Dm644 "$srcdir/greencurve-resume.service" "$pkgdir/usr/lib/systemd/system/greencurve-resume.service"

    # Declarative group creation via sysusers
    install -Dm644 "$srcdir/greencurve.sysusers" "$pkgdir/usr/lib/sysusers.d/greencurve.conf"

    # Desktop launcher
    install -Dm644 "$srcdir/greencurve.desktop" "$pkgdir/usr/share/applications/greencurve.desktop"

    # Application icons
    install -Dm644 "$srcdir/greencurve.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/greencurve.png"
    install -Dm644 "$srcdir/greencurve.png" "$pkgdir/usr/share/pixmaps/greencurve.png"

    # License and documentation
    install -Dm644 "$srcdir/$_src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/$_src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
